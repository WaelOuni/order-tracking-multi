# Ports publiés exclusivement sur 127.0.0.1 par Docker Compose.
APP_PORT=8080
MONGO_PORT=27017
KAFKA_PORT=9092
CATALOG_PORT=8089

# Valeurs pour l'application lancée DEPUIS l'hôte (IntelliJ, WSL ou Maven).
# Compose les remplace explicitement par les noms DNS des conteneurs.
# directConnection empêche le client hôte de rechercher le DNS Docker "mongo".
SPRING_MONGODB_URI=mongodb://localhost:27017/reactive_orders?replicaSet=rs0&directConnection=true&retryWrites=true&w=majority&serverSelectionTimeoutMS=3000
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_CATALOG_BASE_URL=http://localhost:8089
APP_OUTBOX_ENABLED=true
APP_KAFKA_LISTENER_ENABLED=true
SERVER_PORT=8080

# Aucun secret n'est nécessaire pour ce laboratoire local.
# Le service Mongo et Kafka ne sont pas configurés pour un hébergement public.
