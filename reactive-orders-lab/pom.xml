<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Le parent fixe un ensemble de versions compatibles : ne pas versionner Reactor/Netty séparément. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>fr.wael</groupId>
  <artifactId>reactive-orders-lab</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Reactive Orders Lab</name>
  <description>Atelier pédagogique WebFlux, Reactor, MongoDB et Kafka — explications en français.</description>
  <properties>
    <!-- Java 21 permet records et switch modernes, sans confondre threads virtuels et réactivité. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.4.1</archunit.version>
    <mockwebserver.version>4.12.0</mockwebserver.version>
  </properties>
  <dependencies>
    <!-- WebFlux fournit Reactor, WebClient et Netty. Pas de starter-web MVC/Servlet dans cette application. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux</artifactId></dependency>
    <!-- Le pilote Mongo réactif réalise les I/O sans bloquer les event loops, contrairement au pilote synchrone. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-mongodb-reactive</artifactId></dependency>
    <!-- Boot 4 a un starter Kafka dédié. Reactor Kafka est arrêté : notre adaptateur isole KafkaProducer.send. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-kafka</artifactId></dependency>
    <!-- Validation de la frontière HTTP ; les règles métier sont aussi vérifiées dans le domaine. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <!-- Health/readiness et métriques Micrometer ; seuls health et info sont exposés en développement. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <!-- Pas de Lombok : les constructeurs et les invariants restent visibles pour apprendre. -->
    <!-- JUnit Jupiter, Mockito et AssertJ ; Spring Boot choisit leurs versions compatibles. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!-- Boot 4 : infrastructure de test WebFlux/WebTestClient, distincte des tests MVC. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux-test</artifactId><scope>test</scope></dependency>
    <!-- StepVerifier observe les signaux, la demande et l'annulation ; VirtualTimeScheduler évite les sleeps. -->
    <dependency><groupId>io.projectreactor</groupId><artifactId>reactor-test</artifactId><scope>test</scope></dependency>
    <!-- Les tests vérifient que le domaine ne dépend pas de Spring/Mongo/Kafka. -->
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version><scope>test</scope></dependency>
    <!-- Vraies bases et vrai broker : le profil integration requiert Docker et échoue s'il est absent. -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-mongodb</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-kafka</artifactId><scope>test</scope></dependency>
    <!-- Petit serveur HTTP réel pour tester les statuts, timeouts et retries du WebClient. -->
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>mockwebserver</artifactId><version>${mockwebserver.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Java 21 : agent Mockito explicite, sans attachement dynamique au processus JVM.
           dependency:properties fournit le chemin du JAR réellement résolu par le BOM. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
        <executions><execution><id>test-agent-path</id><phase>initialize</phase><goals><goal>properties</goal></goals></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <!-- @{argLine} conserve l'agent JaCoCo ajouté juste avant l'exécution. -->
        <configuration><argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine></configuration>
      </plugin>
      <!-- Produit un JAR autonome incluant Netty et les ressources de l'UI. -->
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <!-- verify produit un rapport de couverture ; pas de seuil arbitraire qui pousse à tester les getters. -->
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>integration</id>
      <build><plugins>
        <!-- *Test = rapides avec Surefire ; *IT = infrastructure réelle avec Failsafe. -->
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
          <configuration><argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine></configuration>
          <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
